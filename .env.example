# Servidor
PORT=3001
# Em servidor com proxy HTTPS, use 127.0.0.1 para não expor a API diretamente.
LISTEN_HOST=0.0.0.0
DATABASE_PATH=./data/nayla.db
# Pasta privada para cópias verificadas do banco (consulte DEPLOY_ORACLE_ALWAYS_FREE.md).
BACKUP_DIR=
APP_ORIGIN=http://localhost:3001
NODE_ENV=development

# A Nayla não processa pagamentos dentro do app. Você cobra com um link externo,
# confere o recebimento no Mercado Pago e concede acesso pelo super admin.
# Não configure dados bancários, cartão ou credenciais Mercado Pago na Nayla.
# Em produção, APP_ORIGIN deve ser a origem HTTPS pública do app.

# Necessária para identificar tentativas de repetir o teste em cadastros diferentes.
# No ambiente local, execute `npm run access:secret` para gerar no .env.
# Na hospedagem, gere 32 bytes aleatórios em base64 e guarde o valor estável apenas no backend.
# A troca desse segredo invalida comparações anteriores; não use prefixo VITE_.
ACCESS_IDENTITY_SECRET=

# Opcional: segredo de 32+ caracteres para GET /api/internal/reminders.
# Quando usar Vercel Cron, configure o mesmo valor protegido na Vercel e na API.
# Nunca exponha este valor no app, no navegador, no Git ou em logs.
CRON_SECRET=

# Opcional: login Google. Crie um cliente OAuth 2.0 do tipo Aplicativo da Web.
# Cadastre exatamente APP_ORIGIN/api/auth/google/callback como URI de redirecionamento.
# A mesma origem HTTPS atende o app web e o retorno para Android/iOS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Somente ao compilar o app Android/iOS: origem HTTPS pública da API, sem barra final.
# Deixe vazio para usar web/PWA local na mesma origem da API.
VITE_API_ORIGIN=
# Origem HTTPS do app web usada nos links de agendamento compartilhados pelo app nativo.
VITE_PUBLIC_APP_ORIGIN=

# IA: escolha ollama (padrão local) ou groq (API externa com cota gratuita).
# Configure AI_PROVIDER=groq somente no backend. A chave fica secreta no servidor;
# nunca use prefixo VITE_ ou envie a chave para o app. Mantenha a conta Groq no
# plano Free para que exceder a cota gere erro, sem cobrança automática.
AI_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Cotas locais de chamadas ao Groq: por profissional/dia e global/dia UTC.
# O teto global considera pedidos, não tokens; a própria Groq pode limitar antes.
NAYLA_GROQ_DAILY_LIMIT=20
NAYLA_GROQ_GLOBAL_DAILY_LIMIT=700

# Modo local: modelo Ollama no mesmo servidor da API.
# Instale Ollama e baixe o modelo com `ollama pull qwen3:8b`.
# Mantenha a porta 11434 acessível somente no próprio servidor.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Pesquisa pública de dicas em fontes selecionadas (Sebrae, Google, Anvisa).
# Padrão: ativa. Use off se o servidor não puder acessar essas fontes por HTTPS.
NAYLA_EXTERNAL_RESEARCH=on

# WhatsApp: simulate registra uma mensagem de teste sem enviá-la; meta usa a API oficial.
# Em produção, o padrão é disabled. As credenciais Meta são salvas por empreendedora no painel.
WHATSAPP_MODE=simulate
WHATSAPP_GRAPH_VERSION=v23.0
# Obrigatória para salvar tokens Meta: chave aleatória de 32 bytes codificados em base64.
WHATSAPP_ENCRYPTION_KEY=
