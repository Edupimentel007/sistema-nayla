# Servidor
PORT=3001
DATABASE_PATH=./data/nayla.db
APP_ORIGIN=http://localhost:3001
NODE_ENV=development

# Opcional: IA. Sem chave, a Nayla ainda responde a consultas estruturadas da base.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Opcional: confirmação pelo WhatsApp Cloud API da Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=confirmacao_agendamento
WHATSAPP_GRAPH_VERSION=v23.0
