# Servidor
PORT=3001
DATABASE_PATH=./data/nayla.db
APP_ORIGIN=http://localhost:3001
NODE_ENV=development

# Cobranças Nayla: crie uma aplicação Mercado Pago e guarde credenciais somente no servidor.
# Configure o recebimento da sua conta no painel Mercado Pago; não coloque dados bancários aqui.
# Webhook de pagamentos e assinaturas: APP_ORIGIN/api/billing/webhooks/mercado-pago.
# Confirme no painel/suporte como a sua aplicação de Assinaturas entrega eventos assinados;
# copie a assinatura secreta correspondente, sem expô-la no cliente ou no Git.
# APP_ORIGIN precisa ser uma origem HTTPS pública para pagamentos reais.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# Opcional: segredo de 32+ caracteres para GET /api/internal/reminders.
# Quando usar Vercel Cron, configure o mesmo valor protegido na Vercel e na API.
# Nunca exponha este valor no app, no navegador, no Git ou em logs.
CRON_SECRET=

# Opcional: login Google. Crie um cliente OAuth 2.0 do tipo Aplicativo da Web.
# Cadastre exatamente APP_ORIGIN/api/auth/google/callback como URI de redirecionamento.
# A mesma origem HTTPS atende o app web e o retorno para Android/iOS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Somente ao compilar o app Android/iOS: origem HTTPS pública da API, sem barra final.
# Deixe vazio para usar web/PWA local na mesma origem da API.
VITE_API_ORIGIN=
# Origem HTTPS do app web usada nos links de agendamento compartilhados pelo app nativo.
VITE_PUBLIC_APP_ORIGIN=

# IA gratuita por chamada: modelo local Ollama no mesmo servidor da API.
# Instale Ollama e baixe o modelo com `ollama pull qwen3:8b`.
# Mantenha a porta 11434 acessível somente no próprio servidor.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b

# Pesquisa pública de dicas em fontes selecionadas (Sebrae, Google, Anvisa).
# Padrão: ativa. Use off se o servidor não puder acessar essas fontes por HTTPS.
NAYLA_EXTERNAL_RESEARCH=on

# WhatsApp: simulate registra uma mensagem de teste sem enviá-la; meta usa a API oficial.
# Em produção, o padrão é disabled. As credenciais Meta são salvas por empreendedora no painel.
WHATSAPP_MODE=simulate
WHATSAPP_GRAPH_VERSION=v23.0
# Obrigatória para salvar tokens Meta: chave aleatória de 32 bytes codificados em base64.
WHATSAPP_ENCRYPTION_KEY=
